{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofvault.dev/schemas/proofvault-manifest-1.0.json",
  "title": "ProofVault Manifest",
  "description": "Canonical description of a sealed ProofVault artifact collection.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "collectionId",
    "name",
    "createdAt",
    "expiresAt",
    "hashAlgorithm",
    "artifacts"
  ],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "collectionId": {
      "type": "string",
      "pattern": "^col_[A-Za-z0-9_-]{16,80}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "hashAlgorithm": {
      "const": "sha256"
    },
    "metadata": {
      "type": "object",
      "maxProperties": 20,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_.-]{1,64}$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 500
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "filename",
        "mediaType",
        "size",
        "sha256",
        "storageKey"
      ],
      "properties": {
        "artifactId": {
          "type": "string",
          "pattern": "^art_[A-Za-z0-9_-]{16,80}$"
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^/\\\\\\u0000]+$"
        },
        "mediaType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 127,
          "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 26214400
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "storageKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "providerRef": {
          "type": "string",
          "maxLength": 2048
        }
      }
    }
  }
}
